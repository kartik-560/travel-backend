generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Trip {
  id                 String           @id @default(auto()) @map("_id") @db.ObjectId
  title              String
  subTitle           String
  maxElevation       String
  duration           String
  distance           String
  difficulty         String
  startPoint         String
  endPoint           String
  travel_description String

  highlights         String[]
  images             String[]
  category String?  
  status             String?          @default("PUBLISHED") // "PUBLISHED" or "HIDDEN"

  whatToExpect       WhatToExpect[]
  days               TripDay[]

  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
}

model WhatToExpect {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  tripId            String   @db.ObjectId
  trip              Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  expect_title      String
  expect_description String
}

model TripDay {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  tripId      String   @db.ObjectId
  trip        Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  day         Int
  description String
  distance    String
  duration    String
  highlights  String[]
}

model ContactFormSubmission {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  email     String
    phone     String?
  message   String
  createdAt DateTime @default(now())
}

model PhotoGallery {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  title      String?
  images     String[] 
  uploadedAt DateTime @default(now())
}

model User {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  email     String   @unique
  name      String?
  password  String   // plain text for Basic Auth (swap to hashing later if you wish)
  role      String   @default("USER") // "ADMIN" or "USER"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
}

model VisitorImpression {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  visitorId   String?  // anonymous client-generated persistent ID
  path        String   @default("/") // e.g. "/", "/itinerary", "/aboutus"
  referrer    String?  // e.g. "https://google.com" or "direct"
  device      String?  // "mobile", "tablet", "desktop"
  browser     String?  // "Chrome", "Safari", etc.
  os          String?  // "Windows", "iOS", "Android", "macOS", etc.
  ip          String?  // client IP or masked IP
  timestamp   DateTime @default(now())

  @@index([timestamp])
  @@index([visitorId])
  @@index([path])
}

model Category {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String   @unique
  createdAt DateTime @default(now())
}

model Testimonial {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  name       String
  role       String
  category   String?  @default("Himalayas")
  images     String[]
  text       String
  location   String
  rating     Int      @default(5)
  tag        String?
  status     String?  @default("PUBLISHED") // "PUBLISHED" or "HIDDEN"
  order      Int?     @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([status])
  @@index([category])
}